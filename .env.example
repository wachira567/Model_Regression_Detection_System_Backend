# === Backend ===
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/eval_db
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxxx
API_SECRET_KEY=generate-a-64-char-random-string
ALLOWED_ORIGINS=["http://localhost:5173"]

# === Thresholds ===
REGRESSION_WARNING_THRESHOLD=0.03
REGRESSION_CRITICAL_THRESHOLD=0.08
DRIFT_WINDOW_SIZE=7
DRIFT_THRESHOLD=0.05

# === LLM Config ===
EVAL_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
